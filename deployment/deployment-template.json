{
  "Name": "${{SERVICE_NAME}}",
  "Labels": {
    "distr-package": "ru.fk.ekb2.ui",
    "distr": "${{DISTR_NAME}}"
  },
  "TaskTemplate": {
    "ContainerSpec": {
      "Image": "${{IMAGE_URL}}",
      "Env": [
        "STAND=${{STAND_NAME}}",
        "APP_NAME=${{APP_NAME::ekb-ui}}",
        "INNER_NETWORK_MASK=10.0.10",
        "CONTAINER_PORT=${{CONTAINER_PORT::8087}}",
        HTTP_SERVER_PORT=8085
        HTTP_PUBLISHED_PORT=9097

      ]
    }
  }
}