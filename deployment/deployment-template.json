{
  "Name": "${{SERVICE_NAME}}",
  "Labels": {
    "distr-package": "ru.fk.ekb2.ui",
    "distr": "${{DISTR_NAME}}"
  },
  "TaskTemplate": {
    "ContainerSpec": {
      "Image": "${{IMAGE_URL}}",
      "Env": [
        "STAND=${{STAND_NAME}}",
        "APP_NAME=${{APP_NAME::ekb-ui}}",
        "HTTP_SERVER_PORT=${{HTTP_SERVER_PORT::8087}}"
      ]
    },
    "LogDriver": {
      "Name": "json-file",
      "Options": {
        "max-file": "5",
        "max-size": "10M"
      }
    },
    "Networks": [
      {
        "Target": "ekb2_net"
      }
    ]
  },
  "EndpointSpec": {
    "Mode": "vip",
    "Ports": [
      {
        "Name": "HTTP",
        "Protocol": "tcp",
        "TargetPort": "$UNQUOTE{{HTTP_SERVER_PORT::8087}}",
        "PublishedPort": "$UNQUOTE{{HTTP_PUBLISHED_PORT}}",
        "PublishMode": "ingress"
      }
    ]
  }
}